# 复制本文件为 .env 后填写（不要改 env.example 当配置用）
# https://www.prisma.io/docs/concepts/database-connectors/postgresql

# Supabase：Transaction pooler（应用运行时常用）
DATABASE_URL="postgresql://postgres.xxxxx:[YOUR-PASSWORD]@aws-0-xxxx.pooler.supabase.com:6543/postgres?pgbouncer=true"

# 同页「Direct connection」或 Session pooler :5432 —— prisma db push / migrate 必须用这条，否则会长时间卡住
# 若不用连接池（本机 Postgres），可与 DATABASE_URL 填成完全相同的一行
DIRECT_URL="postgresql://postgres.xxxxx:[YOUR-PASSWORD]@aws-0-xxxx.pooler.supabase.com:5432/postgres"

# NextAuth — 本地生成：在 PowerShell 可运行 [Convert]::ToBase64String((1..32|%{Get-Random -Max 256}) -join'' 的变体) 或用 openssl
AUTH_SECRET="replace-with-random-secret-at-least-32-chars"
AUTH_TRUST_HOST="true"

# ---------- Supabase Storage（附件 + PDF/便签预览）----------
# 三项必须同时填写，否则上传附件会写入占位符 fileUrl=local:...，笔记详情页会提示「未配置云存储」。
# 取值位置：Supabase Dashboard → Project Settings → API
#   - Project URL        → NEXT_PUBLIC_SUPABASE_URL
#   - anon public        → NEXT_PUBLIC_SUPABASE_ANON_KEY
#   - service_role       → SUPABASE_SERVICE_ROLE_KEY（仅服务端，勿提交到公开仓库）
# Storage：Dashboard → Storage 新建 bucket，默认名 notes；公开读策略可执行 docs/supabase-storage-notes.sql
# 修改本文件后：务必重启 npm run dev；已存在的 local: 笔记需重新上传附件才会变成真实 https 链接。
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="notes"
